msgid "Took a switch out of a set"
msgstr "세트에서 스위치 제거"

msgid "Took back the change of a cloth"
msgstr "클로스 변경 되돌림"

msgid "Took back the import: {removed} folder(s) and file(s) removed"
msgstr "가져오기 되돌림: 폴더 및 파일 {removed}개 제거됨"

msgid "Took back the {count} garment(s) of a drop"
msgstr "놓기로 추가된 의상 {count}개 되돌림"

