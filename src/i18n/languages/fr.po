msgstr "Les tables d'états de mission ne se lisent pas : {e}"

msgid "{count} mission state table, as the body was read: an edit of the document is not shown here"
msgid_plural "{count} mission state tables, as the body was read: an edit of the document is not shown here"
msgstr[0] "{count} table d'états de mission, telle que le corps a été lu : une modification du document n'apparaît pas ici"
msgstr[1] "{count} tables d'états de mission, telles que le corps a été lu : une modification du document n'apparaît pas ici"

