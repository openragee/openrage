msgstr "Index {index} liegt hinter seiner Palette von {count}"

msgid "its palette names hash_{hash}, the name hash of no bone of {model}"
msgstr "seine Palette nennt hash_{hash}, den Namenshash keines Knochens von {model}"

msgid "its indices are bones of the drawable's own skeleton, which was not read"
msgstr "seine Indizes sind Knochen des eigenen Skeletts des Drawables, das nicht gelesen wurde"

msgid "index {index} is past the {count} bones of the drawable's own skeleton"
msgstr "Index {index} liegt hinter den {count} Knochen des eigenen Skeletts des Drawables"

msgid "its own skeleton's bone {bone} is no bone of {model}"
msgstr "Knochen {bone} seines eigenen Skeletts ist kein Knochen von {model}"

msgid "The model has no bone whose name hashes to this DOF's id, so it poses nothing."
msgstr "Das Modell hat keinen Knochen, dessen Name auf die ID dieses DOF gehasht wird, daher posiert es nichts."

msgid "This track is no bone's rotation, translation or scale, the only tracks laid out, so it poses nothing."
msgstr "Diese Spur ist weder Rotation noch Translation noch Skalierung eines Knochens, die einzigen ausgelegten Spuren, daher posiert sie nichts."

msgid "not posed"
msgstr "nicht posiert"

msgid "{dofs} DOFs · {frames} frames · {blocks} blocks"
msgstr "{dofs} DOFs · {frames} Frames · {blocks} Blöcke"

msgid "{count} group played one after another · {layers} layers · {dofs} DOFs"
msgid_plural "{count} groups played one after another · {layers} layers · {dofs} DOFs"
msgstr[0] "{count} Gruppe nacheinander abgespielt · {layers} Ebenen · {dofs} DOFs"
msgstr[1] "{count} Gruppen nacheinander abgespielt · {layers} Ebenen · {dofs} DOFs"

