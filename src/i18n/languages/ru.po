msgstr "восток"

msgid "west"
msgstr "запад"

msgid "north"
msgstr "север"

msgid "south"
msgstr "юг"

msgid "GTA VI Navigation Cell"
msgstr "Навигационная ячейка GTA VI"

msgid "Where an archive holds several bodies of one cell, its neighbours join the second in archive order. A side record's chain edge names the polygon on this side of the border; the polygon across it is in the neighbouring cell's body, which opens on its own."
msgstr "Если архив содержит несколько тел одной ячейки, её соседи присоединяются ко второму в порядке архива. Ребро цепочки боковой записи называет полигон по эту сторону границы; полигон по другую её сторону находится в теле соседней ячейки, которое открывается отдельно."

msgid "The {border} border, across which lies cell {cell}: {edges} chain edges of {records} side records, which name {polygons} polygons."
msgstr "Граница «{border}», за которой лежит ячейка {cell}: рёбер цепочек — {edges}, боковых записей — {records}, они называют полигонов: {polygons}."

msgid "The {border} border, side record {record}: polygon {polygon} meets it from {from} to {to}."
msgstr "Граница «{border}», боковая запись {record}: полигон {polygon} касается её от {from} до {to}."

msgid "The {border} border, side record {record}: its edge from {from} to {to} names no polygon."
msgstr "Граница «{border}», боковая запись {record}: её ребро от {from} до {to} не называет ни одного полигона."

msgid "Special link {index}, from polygon {from} to polygon {to}: heading {degrees} degrees counter-clockwise from +y; word_18 {word}, raw."
msgstr "Особая связь {index}, от полигона {from} к полигону {to}: направление {degrees} градусов против часовой стрелки от +y; word_18 {word}, как есть."

msgid "Footprint {index}, kind {kind}, at a height of {z} m: corners {corners}."
msgstr "След {index}, тип {kind}, на высоте {z} м: углы {corners}."

msgid "Polygon {polygon}: steepness {steepness}, raw, whose rule is not known."
msgstr "Полигон {polygon}: крутизна {steepness}, как есть, правило её неизвестно."

msgid "Edge {edge}: word_06 {word}, flags {flags}, raw."
msgstr "Ребро {edge}: word_06 {word}, флаги {flags}, как есть."

msgid "Reading the effects at {offset} of {archive}"
msgstr "Чтение эффектов по смещению {offset} в {archive}"

msgid "Reading the effects of {archive}"
msgstr "Чтение эффектов из {archive}"

msgid "{count} effect read: GTA VI drawables name their shaders by it"
msgid_plural "{count} effects read: GTA VI drawables name their shaders by them"
msgstr[0] "Прочитан {count} эффект: по нему drawable GTA VI называют свои шейдеры"
msgstr[1] "Прочитано {count} эффекта: по ним drawable GTA VI называют свои шейдеры"
msgstr[2] "Прочитано {count} эффектов: по ним drawable GTA VI называют свои шейдеры"

msgid "The effects were not read: {why}"
msgstr "Эффекты не прочитаны: {why}"

msgid "GTA VI effects"
msgstr "Эффекты GTA VI"

msgid "GTA VI texture names"
msgstr "Имена текстур GTA VI"

msgid "Naming GTA VI textures from their drawables' names"
msgstr "Присвоение имён текстурам GTA VI по именам их drawable"

msgid "{count} GTA VI texture key named from a drawable's name"
msgid_plural "{count} GTA VI texture keys named from drawables' names"
msgstr[0] "{count} ключ текстуры GTA VI получил имя по имени drawable"
msgstr[1] "{count} ключа текстуры GTA VI получили имена по именам drawable"
msgstr[2] "{count} ключей текстур GTA VI получили имена по именам drawable"

msgid "Choose one of the dictionary's drawables first: its export is that drawable"
msgstr "Сначала выберите один из drawable словаря: экспортируется именно он"

msgid "Shader {index} is the effect {effect}, hash_{hash}, and binds {keys} texture keys. The effect declares {named} of its {count} parameters: {names}."
msgstr "Шейдер {index} — это эффект {effect}, hash_{hash}; ключей текстур у него: {keys}. Эффект объявляет {named} из {count} параметров: {names}."

msgid "Shader {index}: the effect {effect}, hash_{hash}"
msgstr "Шейдер {index}: эффект {effect}, hash_{hash}"

msgid "Shader {index}: hash_{hash}, named only by its hash"
msgstr "Шейдер {index}: hash_{hash}, назван только своим хешем"

msgid "buffer {buffer} +{offset}"
msgstr "буфер {buffer} +{offset}"

msgid "{values} · {at} · its effect does not declare it"
msgstr "{values} · {at} · его эффект её не объявляет"

msgid "unresolved"
msgstr "не разрешена"

msgid "{values}, the effect's default"
msgstr "{values}, значение эффекта по умолчанию"

msgid "{values}, where the effect's default is {default}"
msgstr "{values}, тогда как значение эффекта по умолчанию — {default}"

msgid "texture slot {slot} · unbound"
msgstr "слот текстуры {slot} · не привязан"

msgid "texture slot {slot} · {name}, from {source}"
msgstr "слот текстуры {slot} · {name}, из {source}"

msgid "texture slot {slot} · {name} is unresolved: no open texture pack and no dictionary the app has read holds it."
msgstr "слот текстуры {slot} · {name} не разрешена: ни один открытый пак текстур и ни один прочитанный приложением словарь её не содержит."

msgid "texture slot {slot} · {name} is in no texture pack under {folder}: there is no texture to load for this key."
msgstr "слот текстуры {slot} · {name} нет ни в одном паке текстур в {folder}: для этого ключа нечего загружать."

msgid "This texture is unresolved: no open texture pack and no dictionary the app has read holds it."
msgstr "Эта текстура не разрешена: ни один открытый пак текстур и ни один прочитанный приложением словарь её не содержит."

msgid "Select a texture of a GTA VI model in the Gallery first"
msgstr "Сначала выберите в Галерее текстуру модели GTA VI"

msgid "Replace from image"
msgstr "Заменить изображением"

msgid "Replaced {name} in {pack}."
msgstr "{name} заменена в {pack}."

msgid "Save the pack"
msgstr "Сохранить пак"

msgid "Export Texture"
msgstr "Экспортировать текстуру"

msgid "Wrote {path}"
msgstr "Записано: {path}"

msgid "{name} does not read from the document that holds it"
msgstr "{name} не читается из содержащего её документа"

msgid "Shader {shader}, constant {parameter}: buffer {buffer}, offset {offset}, {values}."
msgstr "Шейдер {shader}, константа {parameter}: буфер {buffer}, смещение {offset}, {values}."

msgid "Shader {shader}, constant {parameter}: buffer {buffer}, offset {offset}, {values}; its effect does not declare it."
msgstr "Шейдер {shader}, константа {parameter}: буфер {buffer}, смещение {offset}, {values}; его эффект её не объявляет."

msgid "Its effects are read in the background, and a GTA VI drawable then names its shaders and their parameters by them."
msgstr "Его эффекты читаются в фоне, после чего drawable GTA VI называет по ним свои шейдеры и их параметры."

msgid "a GTA VI drawable is written only once its materials are edited, as a loose resource of its own"
msgstr "drawable GTA VI записывается, только когда его материалы отредактированы, как собственный отдельный ресурс"

msgid "a GTA VI drawable opens only from a scan of the archive that holds it"
msgstr "drawable GTA VI открывается только из сканирования содержащего его архива"

msgid "The record at 0xD0 holds {surfaces} surfaces of {triangles} triangles in the drawable's frame, drawn over the model: they are no level of detail's geometry."
msgstr "Запись по смещению 0xD0 содержит поверхностей: {surfaces}, по {triangles} треугольников, в системе координат drawable, нарисованных поверх модели: это не геометрия какого-либо уровня детализации."

msgid "The record at 0xD0 is not read: {why}"
msgstr "Запись по смещению 0xD0 не прочитана: {why}"

msgid "It has no physics level: its archetype, groups and children are null."
msgstr "Физического уровня у него нет: его архетип, группы и потомки нулевые."

msgid "Its physics level: {groups} groups, each on a bone, and {children} children placed at their groups' bones, {second} of them with a bound of their own outside the composite; the archetype's mass is {mass} kg."
msgstr "Его физический уровень: групп — {groups}, каждая на кости, и потомков — {children}, размещённых у костей своих групп, из них {second} со своим bound вне композита; масса архетипа — {mass} кг."

msgid "{count} bound is listed by bone at 0x38; its frame was not measured, so it is not drawn."
msgid_plural "{count} bounds are listed by bone at 0x38; their frame was not measured, so they are not drawn."
msgstr[0] "{count} bound перечислен по костям по смещению 0x38; его система координат не измерена, поэтому он не нарисован."
msgstr[1] "{count} bound перечислены по костям по смещению 0x38; их система координат не измерена, поэтому они не нарисованы."
msgstr[2] "{count} bound перечислены по костям по смещению 0x38; их система координат не измерена, поэтому они не нарисованы."

msgid "The records the root points at from {slots} are counted and not laid out."
msgstr "Записи, на которые корень указывает из {slots}, посчитаны, но не разложены."

msgid "A cloth record of type {kind}, flag {flag} and owner word {owner}, whose names are not known."
msgstr "Запись cloth типа {kind}, с флагом {flag} и словом-владельцем {owner}, имена которых неизвестны."

msgid "Its {elements} elements and {records} records of two indices, {pairs} of them naming two elements; what they constrain is not known."
msgstr "Его элементов — {elements}, записей из двух индексов — {records}, из них {pairs} называют два элемента; что они ограничивают, неизвестно."

msgid "Its {vertices} simulation vertices and {edges} edges, each with its rest length, and {fillers} filler records."
msgstr "Его вершин симуляции — {vertices}, рёбер — {edges}, у каждого своя длина покоя, и записей-заполнителей — {fillers}."

msgid "Its {strands} guide strands of {points} points each, skinned to {bones} bones, and {triangles} triangles over their roots, which lie in the box {min} to {max}; per-strand arrays {arrays} and index arrays {indices} of its physical buffer. They are drawn in the ped's bind pose, which their box and bones suggest and no field states, each root marked as the point its strand is held by."
msgstr "Его направляющих прядей — {strands}, по {points} точек в каждой, привязанных к {bones} костям, и {triangles} треугольников над их корнями, которые лежат в боксе от {min} до {max}; массивы по прядям {arrays} и массивы индексов {indices} его физического буфера. Они нарисованы в позе привязки педа, которую подсказывают их бокс и кости и которую не задаёт ни одно поле; каждый корень отмечен как точка, в которой держится его прядь."

msgid "Its {shapes} shapes, under {keys} part-name keys: {list}."
msgstr "Его форм — {shapes}, под ключами имён частей ({keys}): {list}."

msgid "Its one box: half extents {extents}, rotation {rotation} and radius {radius}. The record after its arrays is not laid out, so the box is listed and not drawn."
msgstr "Его единственный бокс: полуразмеры {extents}, вращение {rotation} и радиус {radius}. Запись после его массивов не разложена, поэтому бокс указан в списке, но не нарисован."

msgid "Which of its vertices are pinned is not known, so none is marked."
msgstr "Какие из его вершин закреплены, неизвестно, поэтому ни одна не отмечена."

msgid "Physics ({groups} groups, {children} children)"
msgstr "Физика (групп — {groups}, потомков — {children})"

msgid "Group {group}: {bone}"
msgstr "Группа {group}: {bone}"

msgid "Child {child}"
msgstr "Потомок {child}"

msgid "{mass} kg, its own bound"
msgstr "{mass} кг, свой bound"

msgid "A navigation mesh of cell {cell}: {vertices} vertices, {polygons} polygons and {sides} side records, in a quadtree of {nodes} nodes."
msgstr "Навигационный меш ячейки {cell}: вершин — {vertices}, полигонов — {polygons}, боковых записей — {sides}, в квадродереве из {nodes} узлов."

msgid "A navigation octree of cell {cell}: {nodes} nodes, {internal} of them internal, and {placeholder} placeholder, {open} open and {surface} surface leaves."
msgstr "Навигационное октодерево ячейки {cell}: узлов — {nodes}, из них внутренних — {internal}, листьев-заглушек — {placeholder}, свободных — {open} и поверхностных — {surface}."

msgid "{count} child is a primitive bound, drawn from its fields."
msgid_plural "{count} children are primitive bounds, drawn from their fields."
msgstr[0] "{count} потомок — примитивный bound, нарисованный по его полям."
msgstr[1] "{count} потомка — примитивные bound, нарисованные по их полям."
msgstr[2] "{count} потомков — примитивные bound, нарисованные по их полям."

msgid "motion dictionary"
msgstr "словарь движений"

msgid "Word at 0x6C"
msgstr "Слово по смещению 0x6C"

msgid "Sets another body stores"
msgstr "Наборы, которые хранит другое тело"

msgid "Motions"
msgstr "Движения"

msgid "Clip dictionaries drawn on"
msgstr "Используемые словари клипов"

