msgid_plural "{plays}; {count} of its animations are in sets another body stores, named by key"
msgstr[0] "{plays}; {count} его анимация находится в наборе, который хранит другое тело, она названа по ключу"
msgstr[1] "{plays}; {count} его анимации находятся в наборах, которые хранит другое тело, они названы по ключу"
msgstr[2] "{plays}; {count} его анимаций находятся в наборах, которые хранит другое тело, они названы по ключу"

