msgstr "Il documento attivo non è un RPF"

msgid "Active game"
msgstr "Gioco attivo"

msgid "Active game, per-game install folders and keys"
msgstr "Gioco attivo, cartelle di installazione e chiavi di ogni gioco"

msgid "Active game:"
msgstr "Gioco attivo:"

msgid "Add"
msgstr "Aggiungi"

msgid "Add Garment Package"
msgstr "Aggiungi pacchetto del capo"

msgid "Add a build"
msgstr "Aggiungi una build"

