msgid_plural "{count} grass lists name several archetypes, and which one each instance takes is not known"
msgstr[0] "{count} lista de grama nomeia vários arquétipos, e qual deles cada instância usa não é conhecido"
msgstr[1] "{count} listas de grama nomeiam vários arquétipos, e qual deles cada instância usa não é conhecido"

