msgstr "{made}와(과) {weapons}을(를) 무기에 추가했습니다"

msgid "Added {made} and {weapons}; {refused} could not be added: {first}"
msgstr "{made}와(과) {weapons}을(를) 추가했으며, {refused}은(는) 추가할 수 없습니다: {first}"

