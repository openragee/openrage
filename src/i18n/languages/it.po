msgstr "Luci di {maps} mappe: {placed} posizionate, {lod} di livello di dettaglio, {distant} distanti, {probes} sonde di riflessione; {drawn} disegnate"

msgid "Capture"
msgstr "Cattura"

msgid "Clean frame"
msgstr "Immagine pulita"

