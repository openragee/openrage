msgstr "{entities} entidades, {rooms} salas, {portals} portais, {sets} conjuntos de entidades"

msgid "Where an interior's rooms and entities stand in the world is not measured, so they are listed and not drawn"
msgstr "Onde as salas e as entidades de um interior ficam no mundo não é medido, então elas são listadas e não desenhadas"

msgid "Room {room}"
msgstr "Sala {room}"

msgid "{name}: {entities} entities, {portals} portals, floor {floor}"
msgstr "{name}: {entities} entidades, {portals} portais, andar {floor}"

msgid "Its interior was not read: {why}"
msgstr "O interior dela não foi lido: {why}"

