msgstr "Ein GTA VI-Expression-Set mit dem Schlüssel {key}."

msgid "It reads {count} track: the facial controls, or bones, a clip carries."
msgid_plural "It reads {count} tracks: the facial controls, or bones, a clip carries."
msgstr[0] "Es liest {count} Spur: die Gesichtssteuerungen oder Knochen, die ein Clip trägt."
msgstr[1] "Es liest {count} Spuren: die Gesichtssteuerungen oder Knochen, die ein Clip trägt."

