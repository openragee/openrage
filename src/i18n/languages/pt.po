msgid_plural "{count} vehicle glass windows at 0xF0: each a child of the fragment with its shattermap."
msgstr[0] "{count} janela de vidro de veículo em 0xF0: um filho do fragment com o shattermap dele."
msgstr[1] "{count} janelas de vidro de veículo em 0xF0: cada uma um filho do fragment com o shattermap dela."

msgid "Its vehicle glass at 0xF0 is not read: {why}"
msgstr "O vidro de veículo dele em 0xF0 não é lido: {why}"

msgid "{count} glass pane at 0x98, outlined at its owner group's bone while Collision is on."
msgid_plural "{count} glass panes at 0x98, each outlined at its owner group's bone while Collision is on."
msgstr[0] "{count} painel de vidro em 0x98, contornado no osso do grupo proprietário dele enquanto Colisão estiver ativada."
msgstr[1] "{count} painéis de vidro em 0x98, cada um contornado no osso do grupo proprietário dele enquanto Colisão estiver ativada."

