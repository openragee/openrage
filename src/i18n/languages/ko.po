msgstr "중간 세부 수준(LOD)이 너무 무거움"

msgid "Medium level share in percent"
msgstr "중간 레벨 비율(퍼센트)"

msgid "Memory"
msgstr "메모리"

msgid "Mend the pack: fix everything that is safe to, make the textures lighter or give them maps, and repair a model"
msgstr "팩 복구: 안전한 항목은 모두 수정하고, 텍스처를 가볍게 하거나 맵을 추가하며, 모델을 복구합니다"

msgid "Mend the rig of the models of the garment selected: a bone spelt otherwise than the skeleton spells it takes its spelling, a weight on a group with no name of a bone, or a bone the skeleton does not have, goes to the nearest bone above it that it does have, and the weights are cleaned. The model becomes a new source the garment names, and Undo names the old one again"
msgstr "선택한 의상 모델의 리그를 복구합니다. 스켈레톤과 철자가 다르게 쓰인 본은 스켈레톤의 철자를 따르고, 본 이름이 없는 그룹이나 스켈레톤에 없는 본에 있는 가중치는 그 위에 있는 가장 가까운 존재하는 본으로 옮기며, 가중치를 정리합니다. 모델은 의상이 지정하는 새 소스가 되며, 실행 취소하면 이전 소스를 다시 지정합니다"

msgid "Mends bone names and weights no skeleton knows."
msgstr "스켈레톤이 알지 못하는 본 이름과 가중치를 복구합니다."

msgid "Mends what is safe to mend in the models, the textures, the order of the garments and the skins they fit. Nothing is made smaller on purpose and nothing is taken out. One Undo"
msgstr "모델, 텍스처, 의상의 순서, 의상이 맞는 피부에서 안전하게 복구할 수 있는 항목을 복구합니다. 의도적으로 줄이거나 제거하는 것은 없습니다. 실행 취소 한 번으로 되돌립니다"

msgid "Mesh doctor"
msgstr "메시 닥터"

msgid "Meta — schema-driven metadata"
msgstr "Meta — 스키마 기반 메타데이터"

msgid "Meta: {label}"
msgstr "Meta: {label}"

msgid "Meta: {label} (parse error)"
msgstr "Meta: {label} (구문 분석 오류)"

msgid "Meta: {label} ({fields} fields)"
msgstr "Meta: {label} (필드 {fields}개)"

msgid "Metadata"
msgstr "메타데이터"

msgid "Metadata size"
msgstr "메타데이터 크기"

msgid "Metadata, text, string tables, game data tables and audio (.meta, .ymt, .xml, .gxt2, .dat, .rel, .awc, …)"
msgstr "메타데이터, 텍스트, 문자열 테이블, 게임 데이터 테이블, 오디오(.meta, .ymt, .xml, .gxt2, .dat, .rel, .awc, …)"

msgid "MiB"
