msgstr "실행 취소됨, 그 뒤에 다른 작업이 변경한 값 {count}개는 제외: {left_alone}"

msgid "Undone: {restored} value(s) restored"
msgstr "실행 취소됨: 값 {restored}개 복원됨"

msgid "Universal (u)"
msgstr "범용 (u)"

msgid "Unknown"
msgstr "알 수 없음"

msgid "Unless it starts itself, a plugin also needs an ASI loader"
msgstr "플러그인이 스스로 시작하지 않는 한 ASI 로더도 필요합니다"

msgid "Unlink"
msgstr "연결 해제"

msgid "Unlink cloth"
msgstr "클로스 연결 해제"

msgid "Unlink content"
msgstr "콘텐츠 연결 해제"

