msgid "Tick the content each build ships. A split for update cadence is two builds over different contents."
msgstr "각 빌드가 포함할 콘텐츠를 체크하십시오. 업데이트 주기에 따른 분할은 서로 다른 콘텐츠에 대한 두 개의 빌드로 구성합니다."

msgid "Tick the record to paste after first"
msgstr "먼저 그 뒤에 붙여넣을 레코드를 체크하십시오"

msgid "Time of day"
msgstr "시각"

msgid "Timeline"
msgstr "타임라인"

msgid "Tint"
msgstr "색조"

