msgid_plural "{count} GTA VI texture keys named from drawables' names"
msgstr[0] "{count} clave de textura de GTA VI nombrada a partir del nombre de un drawable"
msgstr[1] "{count} claves de textura de GTA VI nombradas a partir de los nombres de drawables"

msgid "Choose one of the dictionary's drawables first: its export is that drawable"
msgstr "Elegir primero uno de los drawables del diccionario: su exportación es ese drawable"

msgid "Shader {index} is the effect {effect}, hash_{hash}, and binds {keys} texture keys. The effect declares {named} of its {count} parameters: {names}."
msgstr "El shader {index} es el efecto {effect}, hash_{hash}, y enlaza {keys} claves de textura. El efecto declara {named} de sus {count} parámetros: {names}."

msgid "Shader {index}: the effect {effect}, hash_{hash}"
msgstr "Shader {index}: el efecto {effect}, hash_{hash}"

msgid "Shader {index}: hash_{hash}, named only by its hash"
msgstr "Shader {index}: hash_{hash}, nombrado solo por su hash"

msgid "buffer {buffer} +{offset}"
msgstr "búfer {buffer} +{offset}"

msgid "{values} · {at} · its effect does not declare it"
msgstr "{values} · {at} · su efecto no lo declara"

