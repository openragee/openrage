msgstr "{name} in {pack} ersetzt. „Speichern unter…“ in seinem Tab schreibt das Dictionary als eigene Datei."

msgid "Indexing the GTA VI texture dictionaries the open archives' scans found"
msgstr "Die GTA VI-Textur-Dictionaries, die die Scans der geöffneten Archive gefunden haben, werden indiziert"

msgid "{count} GTA VI texture dictionary indexed by its textures' keys"
msgid_plural "{count} GTA VI texture dictionaries indexed by their textures' keys"
msgstr[0] "{count} GTA VI-Textur-Dictionary, nach den Schlüsseln seiner Texturen indiziert"
msgstr[1] "{count} GTA VI-Textur-Dictionaries, nach den Schlüsseln ihrer Texturen indiziert"

msgid "{count} GTA VI texture key named from the names file"
msgid_plural "{count} GTA VI texture keys named from the names file"
msgstr[0] "{count} GTA VI-Texturschlüssel aus der Namensdatei benannt"
msgstr[1] "{count} GTA VI-Texturschlüssel aus der Namensdatei benannt"

msgid "Open a GTA VI texture pack first: a names file names the keys of the packs open."
msgstr "Zuerst ein GTA VI-Texturpack öffnen: Eine Namensdatei benennt die Schlüssel der geöffneten Packs."

msgid "{path} is longer than the {count} MiB a names file may be"
msgstr "{path} ist länger als die {count} MiB, die eine Namensdatei haben darf"

