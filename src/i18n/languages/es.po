msgid_plural "{count} links of two groups at 0x50, each with a value whose meaning is not known."
msgstr[0] "{count} vínculo de dos grupos en 0x50, con un valor cuyo significado se desconoce."
msgstr[1] "{count} vínculos de dos grupos en 0x50, cada uno con un valor cuyo significado se desconoce."

