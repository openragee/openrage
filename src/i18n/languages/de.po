msgid_plural "{count} vehicle glass windows at 0xF0: each a child of the fragment with its shattermap."
msgstr[0] "{count} Fahrzeugglas-Fenster bei 0xF0: ein Unterelement des Fragments mit seiner Shattermap."
msgstr[1] "{count} Fahrzeugglas-Fenster bei 0xF0: jedes ein Unterelement des Fragments mit seiner Shattermap."

msgid "Its vehicle glass at 0xF0 is not read: {why}"
msgstr "Sein Fahrzeugglas bei 0xF0 wird nicht gelesen: {why}"

