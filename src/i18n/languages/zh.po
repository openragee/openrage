msgid "(no effect)"
msgstr "（无效果）"

msgid "(no shader group)"
msgstr "（无着色器组）"

msgid "(no skeleton)"
msgstr "（无骨架）"

msgid "A GTA VI body is of neither GTA V edition, so it does not convert"
msgstr "GTA VI 主体不属于任何 GTA V 版本，因此不会转换"

msgid "A map for the game: add .ymap and .ytyp files, and OpenRage shows what they place, lets you move, turn and scale each thing with a manipulator, checks the pack and makes a FiveM resource."
msgstr "游戏地图：添加 .ymap 和 .ytyp 文件，OpenRage 会显示它们放置的内容，可用操纵器移动、旋转和缩放每个对象，检查该包并生成 FiveM 资源。"

msgid "A map pack: add .ymap and .ytyp files to see what they place, move, turn and scale each thing with a manipulator, and see what needs attention before a build"
msgstr "地图包：添加 .ymap 和 .ytyp 文件，查看它们放置的内容，用操纵器移动、旋转和缩放每个对象，并在构建前查看需要注意的问题"

msgid "A map set is shown on the Map screen"
msgstr "地图集合显示在“地图”界面上"

msgid "A particle file is shown on the Particle screen"
msgstr "粒子文件显示在“粒子”界面上"

msgid "A scale is two numbers: one for X and Y together and one for Z. A turn is read as degrees about X, then Y, then Z"
msgstr "缩放由两个数值组成：一个用于 X 和 Y，另一个用于 Z。旋转按先绕 X、再绕 Y、最后绕 Z 的度数读取"

msgid "A weapon is shown on the Weapons screen"
msgstr "武器显示在“武器”界面上"

msgid "A weapon pack: drop weapon models, textures and weapon files to add weapons, change what defines each, and see what needs attention before a build"
msgstr "武器包：拖放武器模型、纹理和武器文件即可添加武器，修改每件武器的定义，并在构建前查看需要注意的问题"

msgid "Add .ymap and .ytyp files: OpenRage shows what they place, lets you move each thing with a manipulator, checks the pack and builds a FiveM resource."
msgstr "添加 .ymap 和 .ytyp 文件：OpenRage 会显示它们放置的内容，可用操纵器移动每个对象，检查该包并构建 FiveM 资源。"

msgid "Add a game folder…"
msgstr "添加游戏文件夹…"

msgid "Add a map pack…"
msgstr "添加地图包…"

msgid "Add a map to this project"
msgstr "向此项目添加地图"

msgid "Add a particle pack…"
msgstr "添加粒子包…"

msgid "Add a weapon called WEAPON_NEW to the pack, in a weapon file of its own with every value at nought for you to set. Give it its real name and values on the Weapons screen"
msgstr "向该包添加一件名为 WEAPON_NEW 的武器，放在其专属的武器文件中，所有值均为零，留待设置。在“武器”界面中为其指定真实名称和值"

msgid "Add a weapon pack to this project"
msgstr "向此项目添加武器包"

msgid "Add a weapon pack…"
msgstr "添加武器包…"

msgid "Add an archetype"
msgstr "添加原型"

msgid "Add an empty list of particle effects to the pack, as a source of its own called fx_new. Open it in the Particle workspace to add effects"
msgstr "向该包添加一个空的粒子效果列表，作为名为 fx_new 的独立源。在“粒子”工作区中打开它即可添加效果"

msgid "Add an entity"
msgstr "添加实体"

msgid "Add as particle effects"
msgstr "添加为粒子效果"

msgid "Add as weapons"
msgstr "添加为武器"

msgid "Add attachment point"
msgstr "添加附着点"

msgid "Add component"
msgstr "添加组件"

msgid "Add map files…"
msgstr "添加地图文件…"

msgid "Add particle effects…"
msgstr "添加粒子效果…"

msgid "Add to the maps"
msgstr "添加到地图"

msgid "Add weapons…"
msgstr "添加武器…"

msgid "Added an entity of {name}"
msgstr "已添加 {name} 的实体"

msgid "Added the archetype {name}"
msgstr "已添加原型 {name}"

msgid "Added the maps content {id}"
msgstr "已添加地图内容 {id}"

msgid "Added the particle list {name}"
msgstr "已添加粒子列表 {name}"

msgid "Added the particles content {id}"
msgstr "已添加粒子内容 {id}"

msgid "Added the weapon {name}"
msgstr "已添加武器 {name}"

msgid "Added the weapons content {id}"
msgstr "已添加武器内容 {id}"

msgid "Added {made} and {weapons} to the weapons"
msgstr "已将 {made} 和 {weapons} 添加到武器"

msgid "Added {made} and {weapons}; {refused} could not be added: {first}"
msgstr "已添加 {made} 和 {weapons}；{refused} 无法添加：{first}"

msgid "Added {made} to the maps"
msgstr "已将 {made} 添加到地图"

msgid "Added {made} to the particles"
msgstr "已将 {made} 添加到粒子"

msgid "Added {made}; {refused} could not be added: {first}"
msgstr "已添加 {made}；{refused} 无法添加：{first}"

msgid "Aiming and accuracy"
msgstr "瞄准与精度"

msgid "Also list the engine's bookkeeping: the words it fills in at run time, counts, reference counts, padding, addresses, binary format codes and vertex strides."
msgstr "同时列出引擎的内部记录：运行时填入的字、计数、引用计数、填充、地址、二进制格式代码和顶点步长。"

msgid "An empty map pack, with the Map screen to fill it."
msgstr "空的地图包，可在“地图”界面中填充。"

msgid "An empty pack of particle effects, with the Particle screen to fill it."
msgstr "空的粒子效果包，可在“粒子”界面中填充。"

msgid "An empty weapon pack, with the Weapons screen to fill it."
msgstr "空的武器包，可在“武器”界面中填充。"

msgid "Animations"
msgstr "动画"

msgid "Another weapon is called {name}: the game resolves a name once"
msgstr "另一件武器也叫 {name}：游戏对每个名称只解析一次"

