msgstr "{name}의 헤어 배율 제거"

msgid "Took the heels off {name}"
msgstr "{name}의 힐 제거"

msgid "Took the price off texture {letter} of {name}"
msgstr "{name}의 텍스처 {letter} 가격 제거"

