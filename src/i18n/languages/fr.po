msgstr "L'enregistrement écrit le texte de chaque bloc tel qu'il est gardé, donc une sauvegarde que rien n'a modifiée est réécrite avec les mêmes octets"

msgid "a packed story save"
msgstr "une sauvegarde d'histoire empaquetée"

msgid "settings"
msgstr "des réglages"

msgid "a profile record"
msgstr "un enregistrement de profil"

