msgstr "текст"

msgid "PSO metadata"
msgstr "метаданные PSO"

msgid "four zero bytes first"
msgstr "сначала четыре нулевых байта"

msgid "zlib, not known"
msgstr "zlib, неизвестно"

msgid "names, encrypted"
msgstr "имена, зашифрованы"

msgid "first entry, not known"
msgstr "первая запись, неизвестна"

