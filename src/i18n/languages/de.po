msgstr "GTA VI-Texturen werden aus {file} benannt"

msgid "Load names…"
msgstr "Namen laden…"

msgid "Name the textures of the open packs from a text file: each line a texture's name, or a drawable's name the naming rules expand"
msgstr "Die Texturen der geöffneten Packs aus einer Textdatei benennen: jede Zeile der Name einer Textur oder der Name eines Drawables, den die Benennungsregeln erweitern"

msgid "Load texture names"
msgstr "Texturnamen laden"

msgid "(raw bytes: edit them in the Text tab)"
msgstr "(Rohbytes: im Tab „Text“ bearbeiten)"

msgid "{count} byte, as two hex digits; the length cannot change"
msgid_plural "{count} bytes, two hex digits each; the length cannot change"
msgstr[0] "{count} Byte, als zwei Hexziffern; die Länge kann sich nicht ändern"
msgstr[1] "{count} Bytes, je zwei Hexziffern; die Länge kann sich nicht ändern"

msgid "Not that many bytes of hex: the value is unchanged"
msgstr "Nicht so viele Bytes Hex: Der Wert bleibt unverändert"

