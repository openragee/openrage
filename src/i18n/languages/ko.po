msgstr "이름의 일부를 입력하면 해당 이름으로 의상을 찾습니다. 또는 조건을 지정하여 조합할 수 있습니다: tag:wool group:coats ped:male slot:jbib polys>5000 lod:missing is:duplicate duplicate-of:jacket problem:model-missing is:problem. 조건 앞에 -를 붙이면 반대로 적용됩니다(-tag:wool). 쿼리를 저장하면 목록의 그룹으로 보관됩니다"

msgid "Type the word first"
msgstr "먼저 단어를 입력하십시오"

msgid "Type the word, and this says what would change"
msgstr "단어를 입력하면 무엇이 변경되는지 표시됩니다"

msgid "Type to filter settings…"
msgstr "입력하여 설정 필터링…"

msgid "Type who made it, where it was found or its licence first: to take a credit away, use Remove credit"
msgstr "먼저 만든 사람, 찾은 위치 또는 라이선스를 입력하십시오: 크레딧을 제거하려면 크레딧 제거를 사용하십시오"

msgid "UVs"
msgstr "UV"

msgid "Unbind"
msgstr "할당 해제"

msgid "Undershirts"
msgstr "언더셔츠"

msgid "Undid '{label}'"
msgstr "“{label}” 실행 취소됨"

msgid "Undo"
msgstr "실행 취소"

msgid "Undo \"{last}\""
msgstr "“{last}” 실행 취소"

msgid "Undo ({n} format(s))"
msgstr "실행 취소(형식 {n}개)"

msgid "Undo add ({count})"
msgstr "추가 실행 취소({count})"

msgid "Undo cloth"
msgstr "클로스 실행 취소"

msgid "Undo clothes change"
msgstr "의상 변경 실행 취소"

msgid "Undo import"
msgstr "가져오기 실행 취소"

msgid "Undo project change"
msgstr "프로젝트 변경 실행 취소"

