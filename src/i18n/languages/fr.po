msgstr "Nouveau nom"

msgid "No stored entry of its kind is there to copy, so {name} is not added."
msgstr "Aucune entrée stockée de son genre n'est là pour être copiée, si bien que {name} n'est pas ajouté."

msgid "Parameter objects, by type: {types}"
msgstr "Objets de paramètre, par type : {types}"

msgid "Parameter {name}: words {words}, word {word}, from {min} to {max}"
msgstr "Paramètre {name} : mots {words}, mot {word}, de {min} à {max}"

msgid "Remove a frame filter or animation record"
msgstr "Retirer un filtre d'images ou un enregistrement d'animation"

