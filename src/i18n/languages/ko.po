msgstr "{what}의 태그 {tag} 제거"

msgid "Took the tag {word} off {what}"
msgstr "{what}의 태그 {word} 제거"

msgid "Took {element} off the shop entry of texture {letter} of {name}"
msgstr "{name}의 텍스처 {letter} 상점 항목에서 {element} 제거"

msgid "Took {name} out of its group"
msgstr "{name} 그룹에서 제외"

msgid "Took {what} out of their group"
msgstr "{what} 그룹에서 제외"

msgid "Tools"
msgstr "도구"

msgid "Automate ▸ Plugin commands"
msgstr "자동화 ▸ 플러그인 명령"

