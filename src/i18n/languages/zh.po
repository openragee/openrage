msgstr "未能读取其 0xA0 处的晶格：{why}"

msgid "Wheels ({count})"
msgstr "车轮（{count}）"

msgid "{bone}: group {group}, child {child}"
msgstr "{bone}：组 {group}，子项 {child}"

msgid "Vehicle glass ({windows} windows)"
msgstr "车窗玻璃（{windows} 块窗）"

msgid "Window {window}: child {child}, {bone}"
msgstr "窗 {window}：子项 {child}，{bone}"

msgid "Glass panes ({panes})"
msgstr "玻璃面板（{panes}）"

