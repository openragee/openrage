msgstr "Textura vacía {letter} agregada a {name}"

msgid "Added an empty texture {letter} to {name}: it ships no file, and a texture you add later can take its letter"
msgstr "Textura vacía {letter} agregada a {name}: no incluye ningún archivo, y una textura que se agregue más adelante puede ocupar su letra"

msgid "Added now, and written when the archive is saved"
msgstr "Agregado ahora, y escrito al guardar el archivo comprimido"

