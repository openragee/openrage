msgstr "{name} (d'après le texte)"

msgid "Bytes to the next item"
msgstr "Octets jusqu'à l'élément suivant"

msgid "Counted elements"
msgstr "Éléments comptés"

msgid "Each slot a field table or a measured value type places in the item, at its offset, and the bytes between them as they are. A value type is what every item measured holds there, which no table of the file states, so a value may break it; the types are shown only on an item that ends where its layout does."
msgstr "Chaque emplacement qu'une table de champs ou un type de valeur mesuré place dans l'élément, à sa position, et les octets entre eux tels quels. Un type de valeur est ce que tous les éléments mesurés y contiennent, ce qu'aucune table du fichier n'indique, si bien qu'une valeur peut le contredire ; les types ne sont affichés que pour un élément qui finit là où finit sa disposition."

msgid "reference row"
msgstr "ligne de référence"

msgid "group slot"
msgstr "emplacement de groupe"

msgid "hash"
msgstr "hachage"

msgid "wave container"
msgstr "conteneur d'ondes"

msgid "zero"
msgstr "zéro"

msgid "unset"
msgstr "non défini"

msgid "float"
msgstr "flottant"

msgid "float or -1"
msgstr "flottant ou -1"

msgid "{word}, where every item measured holds {held}"
msgstr "{word}, là où tous les éléments mesurés contiennent {held}"

msgid "bytes"
msgstr "octets"

msgid "index key"
msgstr "clé d'index"

msgid "its own key"
msgstr "sa propre clé"

msgid "number or -1"
msgstr "nombre ou -1"

msgid "2-bit flags"
msgstr "drapeaux de 2 bits"

msgid "item offset"
msgstr "position d'élément"

