msgstr[1] "{count} nombres de GTA VI conservados, {new} nuevos; {labelled} cuerpos indican su propio nombre y {keys} claves de textura tienen nombre"

msgid "Harvest GTA VI names"
msgstr "Recopilar nombres de GTA VI"

