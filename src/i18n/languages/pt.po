msgstr "parentIndex indexa as entidades do mapa pai escolhido, depois as listas de props dele, depois as listas de grama dele"

msgid "The plan draws its instances as points"
msgstr "A planta desenha as instâncias dele como pontos"

msgid "Reading {count} GTA VI model to draw in place"
msgid_plural "Reading {count} GTA VI models to draw in place"
msgstr[0] "Lendo {count} modelo do GTA VI para desenhar no lugar"
msgstr[1] "Lendo {count} modelos do GTA VI para desenhar no lugar"

