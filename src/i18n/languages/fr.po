msgstr "Lire la zone affichée"

msgid "Read the maps of the archive that meet the part of the plan in view"
msgstr "Lire les cartes de l'archive qui touchent la partie du plan affichée"

msgid "{maps} maps, {entities} entities, {lights} lights and {links} lane links read of the archive"
msgstr "{maps} cartes, {entities} entités, {lights} lumières et {links} liens de voies lus dans l'archive"

msgid "{level}, in the map at {offset}"
msgstr "{level}, dans la carte à {offset}"

msgid "Open its map"
msgstr "Ouvrir sa carte"

msgid "Open the map body that places the picked entity"
msgstr "Ouvrir le corps de carte qui place l'entité choisie"

msgid "Reading the world of {archive}"
msgstr "Lecture du monde de {archive}"

