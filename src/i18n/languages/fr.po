msgstr "Groupe {group}, plages de colonnes {ranges}, listes de poids {lists}"

msgid "Group {group}, constants: {values}"
msgstr "Groupe {group}, constantes : {values}"

msgid "Group {group}, database bounds {bounds}, hash at 0x80 {hash}, weight lists {lists}"
msgstr "Groupe {group}, bornes de la base {bounds}, hachage à 0x80 {hash}, listes de poids {lists}"

msgid "Group {group}, grid {index}: words {words}, cells {cells}, bounds {bounds}, cell sizes {sizes}, inverses {inverses}"
msgstr "Groupe {group}, grille {index} : mots {words}, cellules {cells}, bornes {bounds}, tailles de cellule {sizes}, inverses {inverses}"

msgid "Group {group}, lists {lists}, hashes {hashes}"
msgstr "Groupe {group}, listes {lists}, hachages {hashes}"

msgid "Group {group}, phase curve {index}: points {points}, x from {x0} to {x1}, y1 {y1}, {cycles} cycles"
msgstr "Groupe {group}, courbe de phase {index} : points {points}, x de {x0} à {x1}, y1 {y1}, {cycles} cycles"

msgid "Group {group}, range {lo} to {hi}: hashes {hashes}, bounds {bounds}"
msgstr "Groupe {group}, plage de {lo} à {hi} : hachages {hashes}, bornes {bounds}"

msgid "Group {group}, simplex {index}: {words}"
msgstr "Groupe {group}, simplexe {index} : {words}"

msgid "Matcher bytes at {at}"
msgstr "Octets de l'apparieur à {at}"

msgid "Matcher words at {at}"
msgstr "Mots de l'apparieur à {at}"

