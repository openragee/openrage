msgid_plural "{count} of {of} GTA VI clips found in the open scans"
msgstr[0] "{count} von {of} GTA VI-Clip in den geöffneten Scans gefunden"
msgstr[1] "{count} von {of} GTA VI-Clips in den geöffneten Scans gefunden"

