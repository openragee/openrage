msgid "No texture dictionary is among the rows selected"
msgstr "Среди выбранных строк нет словарей текстур"

msgid "Over a whole install, from a terminal:"
msgstr "Для всей установки игры, из терминала:"

msgid "Export into a folder"
msgstr "Экспортировать в папку"

msgid "Nothing selected is a file this exports"
msgstr "Среди выбранного нет файлов, которые экспортирует эта команда"

