msgstr "Regola della particella {name}: tipo di disegno {draw}, tipo di ordinamento {sort}, shader hash_{shader}, il cui nome non è noto."

msgid "Its shader words select lightingmode {lighting}, projectionmode {projection} and diffusemode {diffuse}."
msgstr "Le sue parole di shader selezionano lightingmode {lighting}, projectionmode {projection} e diffusemode {diffuse}."

msgid "Its shader switches: {switches}."
msgstr "I suoi switch dello shader: {switches}."

msgid "Its sprite is texture slot {slot}, of {count} frame."
msgid_plural "Its sprite is texture slot {slot}, of {count} frames."
msgstr[0] "Il suo sprite è lo slot di texture {slot}, di {count} fotogramma."
msgstr[1] "Il suo sprite è lo slot di texture {slot}, di {count} fotogrammi."

msgid "It sets none of the sprite's texture slots 0, 6, 5 and 12."
msgstr "Non imposta nessuno degli slot di texture 0, 6, 5 e 12 dello sprite."

