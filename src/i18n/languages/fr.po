msgstr "Texture vide {letter} ajoutée à {name}"

msgid "Added an empty texture {letter} to {name}: it ships no file, and a texture you add later can take its letter"
msgstr "Texture vide {letter} ajoutée à {name} : elle ne livre aucun fichier, et une texture ajoutée plus tard peut prendre sa lettre"

msgid "Added now, and written when the archive is saved"
msgstr "Ajouté maintenant, et écrit quand l'archive est enregistrée"

msgid "Added the build {name}"
msgstr "Build {name} ajouté"

msgid "Added the clothing content {id}"
msgstr "Contenu Vêtements {id} ajouté"

msgid "Added the garment in the package {shown} to the pack"
msgstr "Vêtement du paquet {shown} ajouté au pack"

msgid "Added the package {shown}"
msgstr "Paquet {shown} ajouté"

msgid "Added {added} file(s)"
msgstr "{added} fichier(s) ajouté(s)"

