msgstr "{file} ist ein neues Archiv mit den Änderungen des Baums; das Spiel lehnt es ab, weil nur sein Hersteller die dadurch geänderte Tabelle signieren kann."

msgid "the tree is no GTA VI archive opened on its own"
msgstr "der Baum ist kein für sich geöffnetes GTA-VI-Archiv"

msgid "an archive of the tree is no longer open"
msgstr "ein Archiv des Baums ist nicht mehr geöffnet"

msgid "entry {index} states no start"
msgstr "Eintrag {index} gibt keinen Anfang an"

msgid "{name} has no body of its own"
msgstr "{name} hat keinen eigenen Inhalt"

msgid "{name} is an archive moved in from another, which the GTA VI writer does not add"
msgstr "{name} ist ein aus einem anderen Archiv verschobenes Archiv, das der GTA-VI-Schreiber nicht hinzufügt"

msgid "{name} holds no bytes"
msgstr "{name} enthält keine Bytes"

msgid "list {list}: {entries}"
msgstr "Liste {list}: {entries}"

msgid "Add to the facial controls it writes"
msgstr "Zu den Gesichtssteuerungen hinzufügen, die es schreibt"

msgid "{count} byte over"
msgid_plural "{count} bytes over"
msgstr[0] "{count} Byte zu viel"
msgstr[1] "{count} Bytes zu viel"

