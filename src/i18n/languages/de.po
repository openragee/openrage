msgstr "Clips ({count})"

msgid "Database of group {group}: {tables} tables of {rows} rows in all, {grids} grids; a row is four items of four 16-bit floats, whose meaning is not known"
msgstr "Datenbank der Gruppe {group}: insgesamt {tables} Tabellen mit {rows} Zeilen, {grids} Raster; eine Zeile besteht aus vier Elementen zu je vier 16-Bit-Floats, deren Bedeutung nicht bekannt ist"

