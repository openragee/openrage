msgstr "XML нового элемента текстуры {letter}"

msgid "XML of the element {name} of texture {letter}"
msgstr "XML элемента {name} текстуры {letter}"

msgid "YBN — collision bound"
msgstr "YBN — коллизионный bound"

msgid "YCD — animation clip dictionary"
msgstr "YCD — словарь клипов анимации"

msgid "YDD — drawable dictionary"
msgstr "YDD — словарь drawable"

msgid "YDR — drawable model"
msgstr "YDR — модель drawable"

msgid "YED — procedural-bone expressions"
msgstr "YED — выражения процедурных костей"

msgid "YFD — animation blend masks"
msgstr "YFD — маски смешивания анимации"

msgid "YFT — fragment"
msgstr "YFT — фрагмент"

msgid "YLD — cloth dictionary"
msgstr "YLD — словарь cloth"

msgid "YND — traffic path nodes"
msgstr "YND — узлы транспортных путей"

msgid "YNV — navmesh cell"
msgstr "YNV — ячейка navmesh"

msgid "YPDB — pose matcher database"
msgstr "YPDB — база данных pose matcher"

msgid "YPT — particle effects"
msgstr "YPT — эффекты частиц"

msgid "YTD — texture dictionary"
msgstr "YTD — словарь текстур"

