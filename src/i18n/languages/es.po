msgstr "esfera"

msgid "capsule"
msgstr "cápsula"

msgid "box"
msgstr "caja"

msgid "tapered capsule"
msgstr "cápsula cónica"

msgid "disc"
msgstr "disco"

msgid "cylinder"
msgstr "cilindro"

msgid "hull of eight corners"
msgstr "envolvente de ocho esquinas"

msgid "frustum of two radii"
msgstr "tronco de cono de dos radios"

msgid "Child {child} is a {shape}: half extents {x}, {y} and {z} m about its centre, radius {radius} m."
msgstr "El hijo {child} es un {shape}: semiextensiones {x}, {y} y {z} m en torno a su centro, radio {radius} m."

msgid "Child {child}: {ends} cylinders name one vertex as both ends, so they state no axis and are drawn as a point marker; the BVH leaf of {off} cylinders disagrees with the box their fields give, and they are drawn from their ends."
msgstr "Hijo {child}: {ends} cilindros nombran un mismo vértice como ambos extremos, así que no indican ningún eje y se dibujan como un marcador puntual; la hoja del BVH de {off} cilindros contradice la caja que dan sus campos, y se dibujan a partir de sus extremos."

msgid "east"
msgstr "este"

