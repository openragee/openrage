msgid_plural "{count} effects read: GTA VI drawables name their shaders by them"
msgstr[0] "已读取 {count} 个效果：GTA VI 的 drawable 以它们命名其着色器"
msgstr[1] "已读取 {count} 个效果：GTA VI 的 drawable 以它们命名其着色器"

