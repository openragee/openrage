msgstr "多边形 {polygon}：steepness {steepness}，原始值，其规则未知。"

msgid "Edge {edge}: word_06 {word}, flags {flags}, raw."
msgstr "边 {edge}：word_06 {word}，flags {flags}，原始值。"

