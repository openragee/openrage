msgstr "{values}, donde el valor predeterminado del efecto es {default}"

msgid "texture slot {slot} · unbound"
msgstr "slot de textura {slot} · sin enlazar"

msgid "texture slot {slot} · {name}, from {source}"
msgstr "slot de textura {slot} · {name}, de {source}"

msgid "texture slot {slot} · {name} is unresolved: no open texture pack and no dictionary the app has read holds it."
msgstr "slot de textura {slot} · {name} está sin resolver: ningún pack de texturas abierto ni diccionario que la aplicación haya leído la contiene."

msgid "texture slot {slot} · {name} is in no texture pack under {folder}: there is no texture to load for this key."
msgstr "slot de textura {slot} · {name} no está en ningún pack de texturas bajo {folder}: no hay ninguna textura que cargar para esta clave."

