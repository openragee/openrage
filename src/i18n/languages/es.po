msgstr "oeste"

msgid "north"
msgstr "norte"

msgid "south"
msgstr "sur"

msgid "GTA VI Navigation Cell"
msgstr "Celda de navegación de GTA VI"

msgid "Where an archive holds several bodies of one cell, its neighbours join the second in archive order. A side record's chain edge names the polygon on this side of the border; the polygon across it is in the neighbouring cell's body, which opens on its own."
msgstr "Donde un archivo comprimido contiene varios cuerpos de una misma celda, sus vecinas se unen al segundo en el orden del archivo comprimido. La arista de cadena de un registro lateral nombra el polígono de este lado del borde; el polígono de enfrente está en el cuerpo de la celda vecina, que se abre por separado."

msgid "The {border} border, across which lies cell {cell}: {edges} chain edges of {records} side records, which name {polygons} polygons."
msgstr "El borde {border}, al otro lado del cual está la celda {cell}: {edges} aristas de cadena de {records} registros laterales, que nombran {polygons} polígonos."

msgid "The {border} border, side record {record}: polygon {polygon} meets it from {from} to {to}."
msgstr "Borde {border}, registro lateral {record}: el polígono {polygon} lo toca de {from} a {to}."

msgid "The {border} border, side record {record}: its edge from {from} to {to} names no polygon."
msgstr "Borde {border}, registro lateral {record}: su arista de {from} a {to} no nombra ningún polígono."

msgid "Special link {index}, from polygon {from} to polygon {to}: heading {degrees} degrees counter-clockwise from +y; word_18 {word}, raw."
msgstr "Vínculo especial {index}, del polígono {from} al polígono {to}: rumbo de {degrees} grados en sentido antihorario desde +y; word_18 {word}, sin procesar."

msgid "Footprint {index}, kind {kind}, at a height of {z} m: corners {corners}."
msgstr "Huella {index}, de tipo {kind}, a una altura de {z} m: esquinas {corners}."

msgid "Polygon {polygon}: steepness {steepness}, raw, whose rule is not known."
msgstr "Polígono {polygon}: steepness {steepness}, sin procesar, cuya regla se desconoce."

msgid "Edge {edge}: word_06 {word}, flags {flags}, raw."
msgstr "Arista {edge}: word_06 {word}, flags {flags}, sin procesar."

msgid "Reading the effects at {offset} of {archive}"
msgstr "Leyendo los efectos en {offset} de {archive}"

msgid "Reading the effects of {archive}"
msgstr "Leyendo los efectos de {archive}"

msgid "{count} effect read: GTA VI drawables name their shaders by it"
msgid_plural "{count} effects read: GTA VI drawables name their shaders by them"
msgstr[0] "{count} efecto leído: los drawables de GTA VI nombran sus shaders por él"
msgstr[1] "{count} efectos leídos: los drawables de GTA VI nombran sus shaders por ellos"

