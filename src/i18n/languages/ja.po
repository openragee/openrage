msgstr[1] "{count} 個のボディが見つかりました。{missing}が欠けています (ダウンロードで届いていない部分)。{unclaimed}はどのボディにも属していません。"

msgid "archive header: {count} entry, table to {toc}, names {names} bytes"
msgid_plural "archive header: {count} entries, table to {toc}, names {names} bytes"
msgstr[0] "アーカイブヘッダー：エントリ {count} 個、{toc}までのテーブル、名前 {names} バイト"
msgstr[1] "アーカイブヘッダー：エントリ {count} 個、{toc}までのテーブル、名前 {names} バイト"

msgid "where this archive ends is not known: the scan met another archive's header at {at} before names of its own"
msgstr "このアーカイブの終端は不明です：スキャンは、固有の名前より前の{at}で、別のアーカイブのヘッダーに出会いました"

