msgstr "자동화 ▸ 플러그인 실행"

msgid "Tops"
msgstr "상의"

msgid "Torsos"
msgstr "상체"

msgid "Total: {files}, {size}"
msgstr "합계: {files}, {size}"

msgid "Tour"
msgstr "둘러보기"

msgid "Translate your install's shaders so the viewport draws models as the game does. Runs in the background, once; later launches reuse the result."
msgstr "게임 설치의 셰이더를 변환하여 뷰포트가 게임과 같은 방식으로 모델을 그리게 합니다. 백그라운드에서 한 번 실행되며, 이후 실행에서는 그 결과를 재사용합니다."

msgid "Trash"
msgstr "휴지통"

