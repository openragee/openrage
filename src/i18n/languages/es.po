msgid "GTA VI height map"
msgstr "mapa de alturas de GTA VI"

msgid "GTA VI height grid, one array"
msgstr "cuadrícula de alturas de GTA VI, un solo array"

msgid "GTA VI span grid"
msgstr "cuadrícula de tramos de GTA VI"

msgid "GTA VI MoVE network"
msgstr "red MoVE de GTA VI"

msgid "Scaleform movie"
msgstr "película Scaleform"

msgid "EDUP, high entropy"
msgstr "EDUP, entropía alta"

