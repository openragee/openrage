msgstr "正在扫描 {folder} 下的每个 GTA VI 归档"

msgid "{count} archive scanned; now {archive}"
msgid_plural "{count} archives scanned; now {archive}"
msgstr[0] "已扫描 {count} 个归档；当前为 {archive}"
msgstr[1] "已扫描 {count} 个归档；当前为 {archive}"

msgid "{count} GTA VI archive scanned, {bodies} bodies found"
msgid_plural "{count} GTA VI archives scanned, {bodies} bodies found"
msgstr[0] "已扫描 {count} 个 GTA VI 归档，找到 {bodies} 个数据体"
msgstr[1] "已扫描 {count} 个 GTA VI 归档，找到 {bodies} 个数据体"

