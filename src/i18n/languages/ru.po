msgstr "Параметры"

msgid "Group {group}: clips {first} to {last}, a curve of type {curve} and a range of type {range}"
msgstr "Группа {group}: клипы с {first} по {last}, кривая типа {curve} и диапазон типа {range}"

msgid "GTA VI pipeline cache"
msgstr "кеш конвейеров GTA VI"

msgid "SGD5 effect container"
msgstr "контейнер эффектов SGD5"

