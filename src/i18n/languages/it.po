msgid_plural "{count} programs are not translated; the first: {why}"
msgstr[0] "{count} programma non è tradotto: {why}"
msgstr[1] "{count} programmi non sono tradotti; il primo: {why}"

msgid "particle effects"
msgstr "effetti particellari"

