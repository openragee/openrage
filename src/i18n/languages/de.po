msgstr "Level-of-Detail-Elternelement"

msgid "{entities} entities, {rooms} rooms, {portals} portals, {sets} entity sets"
msgstr "{entities} Entitäten, {rooms} Räume, {portals} Portale, {sets} Entitätssets"

msgid "Where an interior's rooms and entities stand in the world is not measured, so they are listed and not drawn"
msgstr "Wo die Räume und Entitäten eines Interiors in der Welt stehen, ist nicht vermessen, daher werden sie aufgelistet und nicht gezeichnet"

