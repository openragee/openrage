msgid_plural "{count} bones of the wearer's skeleton, by their names' hashes"
msgstr[0] "{count} Knochen des Skeletts des Trägers, nach dem Hash seines Namens"
msgstr[1] "{count} Knochen des Skeletts des Trägers, nach den Hashes ihrer Namen"

